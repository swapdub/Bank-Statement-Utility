# Example .env file for Vite frontend
# Ports are set automatically from web/.env by run.sh. No need to edit this file manually for normal use.
#
# To override manually (advanced):
# VITE_API_PORT=8000
# VITE_DEV_PORT=5173
# VITE_API_BASE_URL=   # Set to your backend URL for production/non-proxied use, or leave blank for dev

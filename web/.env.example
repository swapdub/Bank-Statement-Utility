# ── web/.env — single source of truth for run.sh and backend config ──

# Port for FastAPI backend (run.sh + Docker external mapping)
BACKEND_PORT=8000

# Port for Vite frontend dev server (run.sh + Docker external mapping)
FRONTEND_PORT=5173

# CORS allowed origins — defaults to "*" (open, suitable for self-hosting)
# To restrict, set to comma-separated origins: http://192.168.1.10:5173,https://myapp.com
# ALLOWED_ORIGINS=*

# Backend URL as seen by clients — only needed for non-Docker production builds
# Leave empty in dev (Vite proxy handles it) and Docker (nginx proxy handles it)
# Set to your server's IP/hostname when building frontend for standalone deployment:
# VITE_API_BASE_URL=http://192.168.1.100:8000
